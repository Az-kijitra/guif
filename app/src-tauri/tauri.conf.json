{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReflexFiles",
  "version": "0.0.0",
  "identifier": "dev.reflexfiles.successor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReflexFiles",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "zoomHotkeysEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
