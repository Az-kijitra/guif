{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (MVP Phase 1 vertical slice: file list + keyboard navigation).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-fs-list-dir",
    "allow-config-load-navigation",
    "allow-config-save-navigation",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
