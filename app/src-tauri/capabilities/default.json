{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (MVP Phase 1 vertical slice: file list + keyboard navigation).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-fs-list-dir",
    "allow-config-load-navigation",
    "allow-config-save-navigation",
    "allow-fs-ops-copy",
    "allow-fs-ops-move",
    "allow-fs-ops-cancel",
    "allow-fs-ops-delete-trash",
    "allow-fs-ops-delete-permanently",
    "allow-fs-ops-rename",
    "allow-fs-ops-create",
    "allow-fs-ops-detect-conflicts",
    "allow-archive-check-create",
    "allow-archive-create",
    "allow-archive-detect-conflicts",
    "allow-archive-extract",
    "allow-archive-cancel",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
